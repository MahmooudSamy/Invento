<UserControl x:Class="Invento.Views.SideMenuBtns"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Invento.Views"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <Storyboard x:Key="OpensubMenuItem">

            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="GridSubItem">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="80"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="ClosesubMenuItem">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="GridSubItem">
                <EasingDoubleKeyFrame KeyTime="0" Value="80"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Left" Background="#ffffff" Panel.ZIndex="10">
        <StackPanel>
            <Button HorizontalContentAlignment="Stretch" Grid.Row="10" Height="40" Cursor="Hand" ToolTip="Dashboard"
              Padding="15" MinWidth="84" HorizontalAlignment="Left" Width="200" Style="{DynamicResource StyleOfSideMenueButton}">
                <Grid  Height="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="Home" Width="32" Height="32" Margin="-11,-12,11,-12" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <TextBlock HorizontalAlignment="Stretch" Text="Dashboard"  VerticalAlignment="Top" Height="18" Margin="0,-3,0,-7" Grid.Column="2" />
                </Grid>
            </Button>

            <Button HorizontalContentAlignment="Stretch" Grid.Row="10" Height="40" Cursor="Hand" ToolTip="Dashboard"
  Padding="15" MinWidth="84" HorizontalAlignment="Left" Width="200" Style="{DynamicResource StyleOfSideMenueButton}">
                <Grid  Height="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="BiscuitMinus" Width="32" Height="32" Margin="-11,-12,11,-12" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <TextBlock HorizontalAlignment="Stretch" Text="Items"  VerticalAlignment="Top" Height="18" Margin="0,-3,0,-7" Grid.Column="2" />
                </Grid>
            </Button>


        </StackPanel>
    </Grid>
</UserControl>
